# Template only — every value below is intentionally blank.
#
# Copy to .env, fill in real values, and never commit that file (.env is
# excluded by .gitignore). Real credentials reach the server as
# environment variables at build/deploy time; see build.sh / deploy.sh.
#
# If a real value ever lands in THIS file by accident, treat the affected
# credential as compromised and rotate it — rotating is cheap, guessing
# about exposure is not.
#
# After editing .env, run `dart run build_runner build` to regenerate env.g.dart.

# ── Supabase (Phase 1b) ──────────────────────────────────────────────────────
# Project URL and service_role key, from Supabase project settings > API.
# service_role bypasses Row Level Security — our repository layer enforces
# workspace isolation instead (see docs/SRS.md §5). Never expose this key
# to a client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth (Phase 1d) ───────────────────────────────────────────────────────────
# Project Settings > API > JWT Settings > JWT Secret. Used only to verify
# access tokens the dashboard sends us — never to issue our own tokens.
SUPABASE_JWT_SECRET=

# ── Server networking (Phase 1b) ─────────────────────────────────────────────
SERVER_PORT=8080

# Public base URL of this server once deployed (or an ngrok URL for local
# webhook testing). Leave empty for plain local development.
WEBHOOK_BASE_URL=
API_BASE_URL=


# ── Admin override token (Phase 1d) ──────────────────────────────────────────
# Generate a random 32-byte URL-safe string. Node (confirmed simplest,
# cross-platform way — `dart -e` is NOT a real Dart CLI flag, despite an
# earlier version of this file claiming otherwise; python3 isn't always
# present, especially on Windows):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=

# ── Channel credentials (Phase 2a) ───────────────────────────────────────────
# AES-256-GCM key protecting Telegram bot tokens (and, in Phase 2b, WhatsApp
# tokens) at rest. Must decode to exactly 32 bytes. Same Node command as
# above works here too — the output is already the right shape:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# No Node? PowerShell (Windows), no extra installs needed:
#   $b=New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); ([Convert]::ToBase64String($b)).Replace('+','-').Replace('/','_').TrimEnd('=')
CHANNEL_CREDENTIAL_MASTER_KEY=

# ── WhatsApp webhook (Phase 2b) ───────────────────────────────────────────────
# Any string you choose — must match exactly what you enter as the "Verify
# Token" in Meta's App Dashboard → WhatsApp → Configuration → Webhooks.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Same idea as WHATSAPP_WEBHOOK_VERIFY_TOKEN, for the Instagram Messaging
# webhook (Meta App Dashboard → Instagram → Webhooks). Any string you choose
# — must match exactly what you enter there. Read directly from the process
# environment rather than through envied — see env.dart's own comment on
# instagramWebhookVerifyToken for why.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# ── AI orchestrator (Phase 3a) ───────────────────────────────────────────────
# None of these are required to start the server — AiOrchestrator just
# skips any provider with an empty key. Set at least one, in this priority
# order (all have usable free tiers, chosen for cost efficiency — see
# ai_orchestrator.dart's header):
#   1. GROQ_API_KEY (recommended — fast, generous free tier): https://console.groq.com
#   2. GEMINI_API_KEY (fallback): https://aistudio.google.com
#   3. OPENROUTER_API_KEY (last resort, free models only): https://openrouter.ai
GROQ_API_KEY=

# Optional — a SECOND Groq account's key. GroqProvider tries this only
# after every model on GROQ_API_KEY has hit a 429 (quota exceeded), before
# ever falling through to Gemini. Same free-tier signup as GROQ_API_KEY,
# just a different account: https://console.groq.com. Leave blank if you
# don't need this extra headroom.
GROQ_API_KEY_2=

GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Owner escalation notifications (Phase 3 — escalation feature) ───────────
# A SEPARATE Telegram bot from any business's own connected channel —
# create it via @BotFather like any bot, but this one is Kola's own, shared
# across every workspace, used only to ping an owner when a conversation
# escalates. Not required for the server to start — Telegram owner
# notifications are simply unavailable until it's set. See
# kola_notifier_bot.dart for the /start -> chat_id flow.
KOLA_NOTIFIER_TELEGRAM_BOT_TOKEN=

# SMTP config for EmailOwnerNotifier. Any real SMTP provider works (Gmail
# with an App Password, SendGrid, Postmark, Mailgun, your own server). Not
# required for the server to start — email owner notifications are simply
# unavailable until these are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Kola

# ── Payment gateways (Phase 5c scaffolding — still Kola's OWN future
#    subscription-billing keys, NOT what powers Phase 8a's live per-
#    workspace payment collection) ────────────────────────────────────────────
# Secret keys only — never the public key, and never paste these into
# kola_dashboard or any client-facing code. STALE-COMMENT CORRECTION (task
# #127/Phase 8a shipped a real, live checkout endpoint — PaymentEndpoint/
# PaymentCheckoutService): that endpoint does NOT read these two vars. Every
# business connects its OWN Paystack/Flutterwave secret key instead
# (PaymentEndpoint.connectGateway, encrypted at rest per-workspace — see
# payment_gateway_credential.spy.yaml). These two vars register a separate,
# still-genuinely-unused PaystackService/FlutterwaveService pair
# (dependency_injection.dart) reserved for Kola's own future SaaS-
# subscription billing — a different direction of money entirely. Still not
# required for the server to start.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# KOLA'S OWN Stripe secret key — used to charge workspaces in markets
# Paystack and Flutterwave do not serve. NOT a business's own key; those
# are supplied per-workspace through the dashboard and encrypted at rest.
STRIPE_SECRET_KEY=

# Same "Kola's own, not a business's" scope as the two keys above — this is
# NOT the per-workspace Flutterwave webhook secret Phase 8a's real
# `/webhooks/flutterwave` route actually checks against (that one is
# supplied per-workspace via PaymentEndpoint.connectGateway's optional
# webhookSecret param, encrypted at rest, never through this file). This
# var has no real caller anywhere in the codebase yet — reserved for the
# same future Kola-owned billing use as PAYSTACK_SECRET_KEY/
# FLUTTERWAVE_SECRET_KEY above, not a bug.
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# ── Google OAuth (Gate 4 — Sheets/Drive/Calendar) ────────────────────────────
# One shared OAuth client for every Google-backed connector. Google Cloud
# Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web
# application). GOOGLE_OAUTH_REDIRECT_URI must exactly match a registered
# Authorized redirect URI on that client, or Google rejects the callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://webserver.kolaa.co/oauth/google/callback
DASHBOARD_BASE_URL=https://dash.kolaa.co

# ── Microsoft OAuth (Gate 4 — OneDrive/SharePoint Excel) ─────────────────────
# One shared app registration for every Microsoft-backed connector. Azure
# portal -> Microsoft Entra ID -> App registrations -> New registration,
# then Certificates & secrets -> New client secret for the second value.
# MICROSOFT_OAUTH_REDIRECT_URI must exactly match a Redirect URI registered
# under Authentication -> Web on that app registration, or Microsoft
# rejects the callback. MICROSOFT_OAUTH_TENANT stays 'organizations'
# unless you specifically need a single-tenant deployment — personal
# Microsoft accounts cannot use this connector at all (the Excel workbook
# API Graph exposes does not support them), see
# microsoft_oauth_service.dart's header.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=https://webserver.kolaa.co/oauth/microsoft/callback
MICROSOFT_OAUTH_TENANT=organizations

# ── Dropbox OAuth (fix-properly pass — Know category) ───────────────────────
# Dropbox App Console (dropbox.com/developers/apps) -> your app -> Settings.
# DROPBOX_REDIRECT_URI must exactly match an entry under "Redirect URIs" on
# that app, or Dropbox rejects the callback. Read directly from the process
# environment rather than through envied — see env.dart's own comment above
# these three vars for why.
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REDIRECT_URI=https://webserver.kolaa.co/oauth/dropbox/callback

# ── HubSpot OAuth (fix-properly pass — Know category) ────────────────────────
# HubSpot Developer account (developers.hubspot.com) -> your app -> Auth
# tab. HUBSPOT_REDIRECT_URI must exactly match a "Redirect URL" configured
# there, or HubSpot rejects the callback.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=https://webserver.kolaa.co/oauth/hubspot/callback

# ── Meta OAuth (fix-properly pass — Sell category) ────────────────────────────
# ONE Meta App shared by BOTH instagram_shop and facebook_catalog — see
# meta_oauth_service.dart's header. Meta App Dashboard
# (developers.facebook.com/apps) -> your app -> Settings -> Basic for the
# App ID/Secret, and Facebook Login -> Settings -> Valid OAuth Redirect
# URIs for META_OAUTH_REDIRECT_URI. The app will need catalog_management,
# instagram_basic, pages_show_list and business_management added under
# App Review -> Permissions before these scopes work for anyone outside
# the app's own test users/roles.
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=https://webserver.kolaa.co/oauth/meta/callback
